procedure create_array_list(variable size) begin
    return create_array(size, 0);
end
procedure is_in_array(variable item, variable array) begin
    return scan_array(array, item) != -1;
end
procedure clear_array(variable array) begin
    resize_array(array, 0);
end
procedure party_member_list_critters() begin
    return party_member_list(false);
end
procedure array_push(variable array, variable item) begin
    variable n = len_array(array);
    resize_array(array, n + 1);
    set_array(array, n, item);
    return array;
end
procedure load_create_array(variable name, variable size) begin
    variable arr = load_array(name);
    if (arr == 0) then begin
        arr = temp_array(size, 0);
        fix_array(arr);
        save_array(name, arr);
    end
    return arr;
end
procedure parse_str_2(variable str, variable x1, variable x2) begin
    variable token;
    variable line;
    variable result;
    variable n;

    line = tokenize(str, 0, CHAR_PERCENT);

    result = line;
    while (line != str) do begin
        token = tokenize(str, line, CHAR_PERCENT);
        line += "%" + token;
        if (token == "") then begin
            result += "%";
        end else begin
            n = atoi(token);
            if (n == 1) then begin
                result += x1;
            end else begin
                if (n == 2) then begin
                    result += x2;
                end
            end
        end
        variable rest = tokenize(str, line, CHAR_PERCENT);
        if (rest != 0) then begin
            line += "%" + rest;
            result += rest;
        end
    end
    return result;
end
procedure fo2tweaks_setting(variable section, variable setting) begin
    return get_ini_setting(fo2tweaks_ini + "|" + section + "|" + setting);
end
procedure is_critter(variable obj) begin
    return obj_type(obj) == OBJ_TYPE_CRITTER;
end
procedure is_container(variable obj) begin
    if (obj_type(obj) != OBJ_TYPE_ITEM) then begin
        return false;
    end
    if (obj_item_subtype(obj) != item_type_container) then begin
        return false;
    end
    return true;
end
procedure in_combat() begin
    return (get_game_mode bwand COMBAT) != 0;
end
procedure mode_ended(variable mode_to_check, variable old_mode, variable new_mode) begin
    if ((old_mode bwand mode_to_check) > 0 and (new_mode bwand mode_to_check) == 0) then begin
        return true;
    end
    return false;
end
procedure in_party(variable obj) begin
    if (is_in_array(obj, party_member_list_critters())) then begin
        return true;
    end
    return false;
end
procedure get_ini_section_ints(variable file, variable section) begin
    variable ar2 = {};
    variable ar = get_ini_section(file, section);
    foreach (variable k: v in ar) begin
        ndebug(k + " " + v);
        ar2[atoi(k)] = atoi(v);
    end
    return ar2;
end
procedure get_party_skill_level(variable skill) begin
    variable who_best;
    variable skill_level = 0;
    foreach (variable who in party_member_list_critters()) begin
        variable who_skill = critter_skill_level(who, skill);
        ndebug(obj_name(who) + " has skill " + skill + " level of " + who_skill);
        if (who_skill >= skill_level) then begin
            skill_level = who_skill;
            who_best = who;
        end
    end
    ndebug(obj_name(who_best) + " has best skill level of " + skill_level);
    return [who_best, skill_level];
end
procedure is_disabled(variable x) begin
    return (critter_state(x) bwand all_disabilities) != 0;
end
procedure healing_init() begin
    doctor_used = load_create_array(doctor_used_array, 0);
    fa_used = load_create_array(fa_used_array, 0);
    msg = add_extra_msg_file(msg_file);
end
procedure mymsg(variable x) begin
    return message_str_game(msg, x);
end
procedure is_player_side(variable user) begin
    return user == dude_obj or in_party(user);
end
procedure user_skill(variable user, variable skill) begin
    if (is_player_side(user)) then begin
        variable best = get_party_skill_level(skill);
        return best[1];
    end
    return critter_skill_level(user, skill);
end
procedure tell(variable user, variable text) begin
    if (is_player_side(user)) then begin
        display_msg(text);
    end
end
procedure heal_disabilities(variable user, variable target, variable effective_skill, variable interactive) begin
    variable chance = effective_skill - doctor_min;
    ndebug("user " + user + ", target " + target + ", eff. doctor " + effective_skill);
    ndebug("chance " + chance + " eff. skill " + effective_skill + " min. doctor " + doctor_min);
    if (chance < 1) then begin
        if (interactive) then begin
            call tell(user, mymsg(msg_no_chance));
        end
        return false;
    end
    variable r = random(1, 100);
    if (r < chance) then begin
        call tell(user, mymsg(msg_heal_disabilities));
        critter_uninjure(target, all_disabilities);
    end else begin
        call tell(user, mymsg(msg_fail_disabilities));
    end
    return true;
end
procedure is_healthy(variable target) begin
    variable max_hp = get_critter_stat(target, STAT_max_hp);
    variable cur_hp = get_critter_stat(target, STAT_current_hp);
    if (cur_hp >= max_hp and not is_disabled(target)) then begin
        return true;
    end else begin
        return false;
    end
end
procedure get_healed_hp(variable user, variable target, variable doctor_level, variable fa_level) begin
    variable mhp = missing_hp(target);
    variable healed = 0;
    if (doctor_level > 100) then begin
        doctor_level = 100;
    end
    if (fa_level > 100) then begin
        fa_level = 100;
    end
    healed = (doctor_level / 100.0) * (fa_level / 100.0) * doctor_mult + random(-1, 1);
    if (user == dude_obj) then begin
        healed = healed + 2 * has_trait(TRAIT_PERK, dude_obj, PERK_healer);
    end
    if (healed < 0) then begin
        healed = 0;
    end
    variable healed_str = sprintf("%f", healed);
    ndebug("missing " + mhp + " doctor_level " + doctor_level + " fa_level " + fa_level + " healed " + healed_str + " max: " + heal_max + " |" + fa_mult + "|" + doctor_mult);
    healed = floor2(healed);
    if (healed > mhp) then begin
        healed = mhp;
    end
    return healed;
end
procedure get_fa_healed(variable target, variable fa_level) begin
    variable mhp = missing_hp(target);
    variable healed = 0;
    if (fa_level > 100) then begin
        fa_level = 100;
    end
    healed = fa_mult * fa_level / 100.0 + random(-1, 1);
    if (healed < 0) then begin
        healed = 0;
    end
    variable healed_str = sprintf("%f", healed);
    ndebug("missing " + mhp + " fa_level " + fa_level + " healed " + healed_str + " | " + fa_mult);
    healed = floor2(healed);
    if (healed > mhp) then begin
        healed = mhp;
    end
    return healed;
end
procedure missing_hp(variable target) begin
    variable max_hp = get_critter_stat(target, STAT_max_hp);
    variable cur_hp = get_critter_stat(target, STAT_current_hp);
    variable mhp = max_hp - cur_hp;
    return mhp;
end
procedure doctor_used_today(variable target) begin
    return is_in_array(obj_pid(target), doctor_used);
end
procedure fa_used_today(variable target) begin
    return is_in_array(obj_pid(target), fa_used);
end
procedure use_doctor(variable user, variable target, variable skill_bonus, variable interactive) begin
    variable doctor_level = user_skill(user, SKILL_DOCTOR);
    variable fa_level = user_skill(user, SKILL_FIRST_AID);
    variable effective_doctor = doctor_level + skill_bonus;
    variable attempted = false;

    ndebug("doctor level " + doctor_level + ", skill bonus " + skill_bonus + ", effective " + effective_doctor);

    if (interactive) then begin
        if (is_critter_dead(target)) then begin
            call tell(user, mymsg(msg_dead));
            return false;
        end
        if (is_healthy(target)) then begin
            call tell(user, obj_name(target) + mymsg(msg_healthy));
            return false;
        end else begin
            if (doctor_used_today(target)) then begin
                variable skill_name = get_skill_name(SKILL_DOCTOR);
                call tell(user, parse_str_2(mymsg(msg_already_used), obj_name(target), skill_name));
                return false;
            end
        end
    end

    ndebug("user " + user + ", target " + target + ", eff. doctor " + effective_doctor);
    ndebug("critter state " + sprintf("%d", critter_state(target)));

    if (is_disabled(target)) then begin
        attempted = heal_disabilities(user, target, effective_doctor, interactive);
    end

    if (missing_hp(target) > 0) then begin
        variable name = obj_name(target);
        variable hp = get_healed_hp(user, target, effective_doctor, fa_level);
        ndebug("trying to heal " + name);
        attempted = true;

        if (hp < 1) then begin
            call tell(user, mymsg(msg_fail));
        end else begin
            critter_heal(target, hp);
            call tell(user, parse_str_2(mymsg(msg_healed_for), obj_name(target), hp));
            if (is_player_side(user)) then begin
                call grant_xp(hp, SKILL_DOCTOR);
            end
        end
    end

    if (attempted) then begin
        call array_push(doctor_used, obj_pid(target));
        set_sfall_global("g_heal_d", get_day);
        if (is_player_side(user)) then begin
            game_time_advance(game_ticks(3600));
        end
    end
    return attempted;
end
procedure use_first_aid(variable user, variable target, variable skill_bonus, variable interactive) begin
    variable fa_level = user_skill(user, SKILL_FIRST_AID);
    variable effective_fa = fa_level + skill_bonus;
    ndebug("fa level " + fa_level + ", skill bonus " + skill_bonus + ", effective " + effective_fa);
    ndebug("userfa " + user + " target " + target);

    if (interactive) then begin
        if (is_critter_dead(target)) then begin
            call tell(user, mymsg(msg_dead));
            return false;
        end
        if (is_healthy(target)) then begin
            call tell(user, obj_name(target) + mymsg(msg_healthy));
            return false;
        end else begin
            if (fa_used_today(target)) then begin
                variable skill_name = get_skill_name(SKILL_FIRST_AID);
                call tell(user, parse_str_2(mymsg(msg_already_used), obj_name(target), skill_name));
                return false;
            end
        end
    end

    if (missing_hp(target) <= 0) then begin
        if (interactive) then begin
            call tell(user, mymsg(msg_fa_disabilities));
        end
        return false;
    end

    variable name = obj_name(target);
    variable hp = get_fa_healed(target, effective_fa);
    ndebug("trying to heal " + name);

    call array_push(fa_used, obj_pid(target));
    set_sfall_global("g_heal_d", get_day);

    if (is_player_side(user)) then begin
        game_time_advance(game_ticks(1800));
    end
    if (hp < 1) then begin
        call tell(user, mymsg(msg_fail));
        return true;
    end
    critter_heal(target, hp);
    call tell(user, parse_str_2(mymsg(msg_healed_for), obj_name(target), hp));
    if (is_player_side(user)) then begin
        call grant_xp(hp, SKILL_FIRST_AID);
    end
    return true;
end
procedure reset_heal_arrays() begin
    ndebug("resetting heal arrays");
    call clear_array(fa_used);
    call clear_array(doctor_used);
end
procedure update_heal_arrays() begin
    variable last_day = get_sfall_global_int("g_heal_d");
    ndebug("Last day " + last_day);
    if (last_day == 0) then begin
        return;
    end
    if (get_day != last_day) then begin
        call reset_heal_arrays();
    end
end
procedure get_skill_name(variable skill) begin
    variable skill_name;
    if (skill == SKILL_DOCTOR) then begin
        skill_name = mstr_skill(doctor_skill_name);
    end else begin
        skill_name = mstr_skill(fa_skill_name);
    end
    return skill_name;
end
procedure grant_xp(variable hp, variable skill) begin
    variable xp = hp * 10;
    variable skill_name = get_skill_name(skill);
    give_exp_points(xp);
    display_msg(parse_str_2(mymsg(msg_got_xp), xp, skill_name));
end
procedure use_skill(variable user, variable target, variable skill, variable skill_bonus) begin
    call update_heal_arrays();
    ndebug("user1 " + user + " target " + target);
    if (skill == SKILL_DOCTOR) then begin
        return use_doctor(user, target, skill_bonus);
    end
    if (skill == SKILL_FIRST_AID) then begin
        return use_first_aid(user, target, skill_bonus);
    end
    return false;
end
/* ===== end bundled ===== */

/* ===== main body ===== */
variable enabled;
variable max_charges;
variable taken_out;
procedure kit_skill(variable pid) begin
    if (pid == PID_DOCTORS_BAG or pid == PID_PARAMEDICS_BAG) then begin
        return SKILL_DOCTOR;
    end
    return SKILL_FIRST_AID;
end
procedure kit_bonus(variable pid) begin
    if (pid == PID_PARAMEDICS_BAG or pid == PID_FIELD_MEDIC_KIT) then begin
        return 40;
    end
    return 20;
end
procedure kit_run_out_msg(variable pid) begin
    if (pid == PID_DOCTORS_BAG) then begin
        return 900;
    end
    if (pid == PID_FIRST_AID_KIT) then begin
        return 901;
    end
    if (pid == PID_PARAMEDICS_BAG) then begin
        return 910;
    end
    return 911;
end
procedure is_kit_pid(variable pid) begin
    return pid == PID_FIRST_AID_KIT or pid == PID_DOCTORS_BAG or pid == PID_FIELD_MEDIC_KIT or pid == PID_PARAMEDICS_BAG;
end
procedure is_managed(variable item) begin
    variable pid = obj_pid(item);
    return is_kit_pid(pid) and max_charges[pid] > 0;
end
/**
 * Gives a kit its charges. A kit made after the proto got its charges starts full; one made before has 0.
 * The engine keeps identical kits as one object with a count, so this fills every kit of a stack.
 */
procedure fill(variable item) begin
    if (not is_managed(item)) then begin
        return;
    end
    variable max = max_charges[obj_pid(item)];
    variable charges = get_weapon_ammo_count(item);
    if (charges == 0 or charges > max) then begin
        set_weapon_ammo_count(item, max);
    end
end
procedure fill_inventory(variable owner) begin
    variable i = 0;
    variable item = inven_ptr(owner, i);
    while (item) do begin
        call fill(item);
        if (is_container(item)) then begin
            call fill_inventory(item);
        end
        i += 1;
        item = inven_ptr(owner, i);
    end
end
procedure fill_map() begin
    foreach (variable item in list_as_array(LIST_GROUNDITEMS)) begin
        call fill(item);
        if (is_container(item)) then begin
            call fill_inventory(item);
        end
    end
    foreach (variable critter in list_as_array(LIST_CRITTERS)) begin
        call fill_inventory(critter);
    end
    intface_redraw;
end
procedure display_run_out(variable user, variable pid) begin
    if (user == dude_obj) then begin
        display_msg(message_str_game(GAME_MSG_PROTO, kit_run_out_msg(pid)));
    end
end
/**
 * Adds a new kit with the given charges to the owner's inventory.
 */
procedure add_kit(variable owner, variable pid, variable charges) begin
    variable kit = create_object_sid(pid, 0, 0, -1);
    set_weapon_ammo_count(kit, charges);
    add_obj_to_inven(owner, kit);
end
procedure useobjon_handler() begin
    variable target = get_sfall_arg;
    variable user = get_sfall_arg;
    variable item = get_sfall_arg;
    variable pid = obj_pid(item);

    if (not is_managed(item)) then begin
        return;
    end

    if (in_combat()) then begin
        return;
    end

    if (not is_critter(target)) then begin
        set_sfall_return(0);
        return;
    end

    call fill(item);
    variable attempted = use_skill(user, target, kit_skill(pid), kit_bonus(pid));
    variable charges = get_weapon_ammo_count(item);
    ndebug("kit " + pid + " attempted " + attempted + ", charges " + charges);
    if (not attempted) then begin
        set_sfall_return(0);
        return;
    end
    if (charges <= 1) then begin
        call display_run_out(user, pid);
        set_sfall_return(1);
        intface_redraw;
        return;
    end

    if (obj_is_carrying_obj(user, item) > 1) then begin
        call add_kit(user, pid, charges - 1);
        set_sfall_return(1);
    end else begin
        set_weapon_ammo_count(item, charges - 1);
        set_sfall_return(0);
    end
    intface_redraw;
end
/**
 * Pours the charges of one kit, dropped on the same kind of kit in a hand, into the one in hand.
 * @returns true if the charges were merged and the move must be cancelled
 */
procedure merge_kits(variable source, variable target) begin
    if (not target or obj_pid(source) != obj_pid(target)) then begin
        return false;
    end

    variable quantity = obj_is_carrying_obj(dude_obj, source);
    if (quantity < 1) then begin
        return false;
    end

    call fill(target);
    variable pid = obj_pid(target);
    variable max = max_charges[pid];
    variable room = max - get_weapon_ammo_count(target);
    if (room <= 0) then begin
        return false;
    end

    variable source_charges = get_weapon_ammo_count(source);
    variable poured = source_charges;
    if (poured > room) then begin
        poured = room;
    end
    variable left = source_charges - poured;
    set_weapon_ammo_count(target, get_weapon_ammo_count(target) + poured);
    if (quantity == 1 and left > 0) then begin
        set_weapon_ammo_count(source, left);
    end else begin
        variable _ = rm_mult_objs_from_inven(dude_obj, source, 1);
        call array_push(taken_out, source);
        if (left > 0) then begin
            call add_kit(dude_obj, pid, left);
        end
    end
    ndebug("merged kits, target charges " + get_weapon_ammo_count(target) + ", source left " + left);
    intface_redraw;
    return true;
end
procedure inventorymove_handler() begin
    variable slot = get_sfall_arg;
    variable item = get_sfall_arg;
    variable replaced = get_sfall_arg;

    if (not is_managed(item)) then begin
        return;
    end
    call fill(item);
    if (slot == slot_left_hand or slot == slot_right_hand) then begin
        if (merge_kits(item, replaced)) then begin
            set_sfall_return(1);
        end
    end else begin
        if (slot == slot_pick_up) then begin
            intface_redraw;
        end
    end
end
procedure destroy_taken_out() begin
    foreach (variable item in taken_out) begin
        destroy_object(item);
    end
    resize_array(taken_out, 0);
end
procedure gamemodechange_handler() begin
    variable old_mode = get_sfall_arg_at(1);
    if (mode_ended(INVENTORY, old_mode, get_game_mode)) then begin
        call destroy_taken_out();
    end
end
procedure map_enter_p_proc() begin
    if (enabled == 1) then begin
        call fill_map();
    end
end
procedure start() begin
    if (game_loaded) then begin
        enabled = fo2tweaks_setting(sec_main, set_item_charges);
        if (enabled != 1) then begin
            return;
        end

        if (fo2tweaks_setting(sec_main, set_healing_revision) != 1) then begin
            ndebug("healing revision is disabled, kits keep their vanilla behaviour");
            enabled = 0;
            return;
        end

        max_charges = get_ini_section_ints(fo2tweaks_ini, sec_item_charges);
        fix_array(max_charges);
        foreach (variable pid: count in max_charges) begin
            if (is_kit_pid(pid)) then begin
                set_proto_data(pid, PROTO_MI_CHARGES, count);
            end else begin
                ndebug("pid " + pid + " is not a medical kit, ignored");
            end
        end
        taken_out = create_array_list(0);

        call healing_init();
        register_hook_proc(HOOK_USEOBJON, useobjon_handler);
        register_hook_proc(HOOK_INVENTORYMOVE, inventorymove_handler);
        register_hook_proc(HOOK_GAMEMODECHANGE, gamemodechange_handler);
        call fill_map();
        ndebug("initialized");
    end
end
/* ===== end main body ===== */
